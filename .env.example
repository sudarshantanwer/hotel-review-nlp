# ⚠️  SECURITY WARNING ⚠️
# This is a TEMPLATE file - safe to commit to GitHub
# NEVER commit actual .env files with real credentials!
# Copy this to .env and replace with real values for local development

# Production Environment Configuration
# Copy this file to .env for local development or set as environment variables in production

# ======================
# APPLICATION SETTINGS
# ======================uction Environment Configuration
# Copy this file to .env for local development or set as environment variables in production

# ======================
# APPLICATION SETTINGS
# ======================
ENVIRONMENT=production
APP_NAME=hotel-review-nlp
VERSION=1.0.0
DEBUG=false

# ======================
# AWS CONFIGURATION
# ======================
AWS_REGION=ap-south-1  # Mumbai region for India users
AWS_ACCOUNT_ID=123456789012  # Replace with your actual AWS account ID

# ======================
# DATABASE CONFIGURATION
# ======================
# For production, DATABASE_URL is automatically configured from AWS Secrets Manager
# For development, uncomment and configure the following:
# DATABASE_URL=sqlite:///./hotel_reviews.db
# DATABASE_URL=postgresql://username:password@localhost:5432/hotelreviewdb

# Database connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ======================
# ML MODEL CONFIGURATION
# ======================
MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
MODEL_CACHE_DIR=/app/models
MAX_SEQUENCE_LENGTH=512

# Model performance thresholds
ACCURACY_THRESHOLD=0.80
CONFIDENCE_THRESHOLD=0.70
DRIFT_THRESHOLD=0.1

# ======================
# API CONFIGURATION
# ======================
API_V1_STR=/api/v1
MAX_REQUEST_SIZE=10485760  # 10MB
RATE_LIMIT_PER_MINUTE=100

# CORS settings
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# ======================
# SECURITY CONFIGURATION
# ======================
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# ======================
# LOGGING CONFIGURATION
# ======================
LOG_LEVEL=INFO
LOG_FORMAT=JSON
LOG_FILE=/app/logs/application.log
ENABLE_ACCESS_LOGS=true

# ======================
# MONITORING & METRICS
# ======================
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30
PERFORMANCE_MONITORING=true

# CloudWatch configuration
CLOUDWATCH_NAMESPACE=HotelReview/Application
ENABLE_CUSTOM_METRICS=true

# ======================
# FRONTEND CONFIGURATION
# ======================
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=Hotel Review Sentiment Analysis
VITE_ENABLE_ANALYTICS=true
VITE_BUILD_MODE=production

# ======================
# ML PIPELINE CONFIGURATION
# ======================
ML_PIPELINE_ENABLED=true
MODEL_EVALUATION_SCHEDULE="0 2 * * 0"  # Weekly at 2 AM Sunday
BATCH_PREDICTION_SIZE=1000
ENABLE_MODEL_MONITORING=true

# Data processing settings
MAX_REVIEW_LENGTH=5000
MIN_REVIEW_LENGTH=10
TEXT_PREPROCESSING=true
ENABLE_PROFANITY_FILTER=false

# ======================
# CACHE CONFIGURATION
# ======================
ENABLE_CACHING=true
CACHE_TYPE=memory
CACHE_TTL=3600  # 1 hour
REDIS_URL=redis://localhost:6379/0  # If using Redis

# ======================
# EMAIL/NOTIFICATION SETTINGS
# ======================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
EMAIL_FROM=noreply@hotelreview.com

# Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
ENABLE_SLACK_NOTIFICATIONS=true

# ======================
# AWS SERVICES CONFIGURATION
# ======================
# S3 Configuration
S3_BUCKET_MODELS=hotel-review-nlp-ml-artifacts
S3_BUCKET_LOGS=hotel-review-nlp-logs
S3_BUCKET_BACKUPS=hotel-review-nlp-backups

# SNS Configuration
SNS_TOPIC_ALERTS=arn:aws:sns:ap-south-1:123456789012:hotel-review-alerts

# Lambda Configuration
LAMBDA_FUNCTION_EVALUATION=hotel-review-nlp-model-evaluation
LAMBDA_TIMEOUT=300

# ======================
# DEVELOPMENT SETTINGS
# ======================
# These are only used in development mode
DEV_ENABLE_RELOAD=true
DEV_SAMPLE_DATA=true
DEV_DEBUG_SQL=false
DEV_ENABLE_PROFILER=false

# ======================
# PRODUCTION OPTIMIZATIONS
# ======================
ENABLE_GZIP=true
ENABLE_RESPONSE_CACHING=true
MAX_WORKERS=4
WORKER_TIMEOUT=120
KEEPALIVE=2

# Database optimization
ENABLE_DB_QUERY_CACHE=true
DB_STATEMENT_TIMEOUT=30000
DB_LOCK_TIMEOUT=10000

# ======================
# BACKUP & RECOVERY
# ======================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 3 * * *"  # Daily at 3 AM
BACKUP_RETENTION_DAYS=30
ENABLE_POINT_IN_TIME_RECOVERY=true

# ======================
# COMPLIANCE & AUDIT
# ======================
ENABLE_AUDIT_LOGGING=true
DATA_RETENTION_DAYS=365
ENABLE_GDPR_COMPLIANCE=true
PRIVACY_POLICY_URL=https://hotelreview.com/privacy

# ======================
# EXPERIMENTAL FEATURES
# ======================
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_A_B_TESTING=false
FEATURE_FLAG_SERVICE_URL=https://feature-flags.example.com
